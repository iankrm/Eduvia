# Local/persistent-server Supabase connection. For Vercel, set DATABASE_URL
# in Vercel's project environment to the Transaction pooler URI from Connect.
# Copy to .env and fill in the project password; do not commit .env.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret

# Only needed for the one-time HTTPS SQLite data import. Server-only secret;
# never expose it in a VITE_* variable or browser bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
